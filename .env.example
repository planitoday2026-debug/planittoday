# Optional: copy to .env to customize. The app works without this file.
HOST=127.0.0.1
PORT=3001
DEV_UI_PORT=5173
DB_PATH=./data/planitoday.sqlite
# For a local AI model, install Ollama separately; preview needs no model.
AI_PROVIDER=preview
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
# Only needed behind an HTTPS reverse proxy:
# APP_ORIGIN=https://your-domain.example
# COOKIE_SECURE=true
